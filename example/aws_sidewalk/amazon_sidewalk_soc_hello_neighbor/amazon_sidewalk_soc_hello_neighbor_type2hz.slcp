project_name: amazon_sidewalk_soc_hello_neighbor_type2hz
package: sidewalk_sample_app
quality: production
label: Amazon Sidewalk - SoC Hello Neighbor Type2Hz
description: The Hello Neighbor sample application leverages the
  Amazon Sidewalk protocol to connect to the cloud using a either
  of the 3 radio layer, depending on board and configuration.
  The application connects to AWS and send or receive messages
  on button push.
category: Example|AWS IoT
source:
  - path: app_init.c
  - path: app_process.c
  - path: app_cli.c
include:
  - path: .
    file_list:
      - path: app_init.h
      - path: app_process.h
component:
  - id: sidewalk_pal
  - id: sidewalk_common
  - id: sidewalk_app_log
  - id: sidewalk_log_app_rtt
  - id: sidewalk_log_pal_rtt
  - id: sidewalk_log_stack_rtt
  - id: sidewalk_utils
  - id: sidewalk_ble
    condition:
      - device_supports_bluetooth
  - id: iostream_rtt
  - id: printf
  - id: sl_main
  - id: cli
    instance:
      - inst
  - id: device_init
  - id: clock_manager
  - id: iostream_stdlib_config
  - id: sleeptimer
  - id: app_assert
  - id: freertos
  - id: freertos_heap_4
  - id: memory_manager
define:
  - name: MAIN_TASK_STACK_SIZE
    value: (4352 / sizeof(configSTACK_DEPTH_TYPE))
configuration:
  - name: SL_BT_CONFIG_MAX_CONNECTIONS
    value: 1
  - name: SL_MBEDTLS_PSA_ASSUME_EXCLUSIVE_BUFFERS
    value: 1
  - name: SL_CLOCK_MANAGER_DEFAULT_HF_CLOCK_SOURCE
    value: SL_CLOCK_MANAGER_DEFAULT_HF_CLOCK_SOURCE_HFRCODPLL
  - name: SL_CLOCK_MANAGER_DEFAULT_LF_CLOCK_SOURCE
    value: SL_CLOCK_MANAGER_DEFAULT_LF_CLOCK_SOURCE_LFXO
  - name: SL_CLOCK_MANAGER_HFXO_EN
    value: 1
  - name: SL_CLOCK_MANAGER_LFXO_EN
    value: 1
  - name: SL_CLOCK_MANAGER_HFRCO_DPLL_EN
    value: 1
  - name: SL_SIDEWALK_COMMON_DEFAULT_LINK_TYPE
    value: SL_SIDEWALK_LINK_BLE
  - name: SL_SIDEWALK_COMMON_DEFAULT_LINK_CONNECTION_POLICY
    value: SID_LINK_CONNECTION_POLICY_NONE
  - name: SL_SIDEWALK_COMMON_DEFAULT_MULTI_LINK_POLICY
    value: SID_LINK_MULTI_LINK_POLICY_RELIABILITY
  - name: SL_SPIDRV_EXP_CS_CONTROL
    value: spidrvCsControlApplication
  - name: SL_SPIDRV_EXP_BITRATE
    value: 8000000
  - name: SL_SLEEPTIMER_PERIPHERAL
    value: SL_SLEEPTIMER_PERIPHERAL_DEFAULT
  - name: SL_SID_LOG_APP_ENABLED
    value: 1
  - name: SL_SID_LOG_PAL_ENABLED
    value: 1
  - name: SID_PAL_LOG_ENABLED
    value: 1
  - name: SL_BOARD_ENABLE_VCOM
    value: 0
    condition:
      - iostream_usart
  - name: SL_IOSTREAM_USART_VCOM_RESTRICT_ENERGY_MODE_TO_ALLOW_RECEPTION
    value: 0
    condition:
      - iostream_usart
  - name: SL_IOSTREAM_USART_VCOM_FLOW_CONTROL_TYPE
    value: usartHwFlowControlNone
    condition:
      - iostream_usart
  - name: SL_CLI_INST_IOSTREAM_HANDLE
    value: sl_iostream_rtt_handle
  - name: configTOTAL_HEAP_SIZE
    value: 15360
  - name: SL_STACK_SIZE
    value: 2048
  - name: NVM3_DEFAULT_NVM_SIZE
    value: 24576
  - name: SL_MAIN_START_TASK_STACK_SIZE_BYTES
    value: 2048
  - name: SL_BT_RTOS_EVENT_HANDLER_STACK_SIZE
    value: 4000
  - name: APP_LOG_AUTO_NL
    value: 1
  - name: SL_BT_CONFIG_MIN_TX_POWER
    value: (-260)
  - name: SL_BT_CONFIG_MAX_TX_POWER
    value: (100)
  - name: APP_LOG_LEVEL_DEBUG_PREFIX
    value: '"<D>"'
  - name: APP_LOG_LEVEL_INFO_PREFIX
    value: '"<I>"'
  - name: APP_LOG_LEVEL_WARNING_PREFIX
    value: '"<W>"'
  - name: APP_LOG_LEVEL_ERROR_PREFIX
    value: '"<E>"'
  - name: APP_LOG_LEVEL_CRITICAL_PREFIX
    value: '"<C>"'
  - name: configUSE_MALLOC_FAILED_HOOK
    value: 1
  - name: configCHECK_FOR_STACK_OVERFLOW
    value: 2
readme:
  - path: ../../../documentation/example/amazon_sidewalk_soc_hello_neighbor/readme.md
ui_hints:
  highlight:
    - path: config/sidewalk/sidewalk.asconf
    - path: readme.md
      focus: true
config_file:
  - path: ../../../tools/cloudformation/public/CF_minimal_sidewalk.json
    directory: sidewalk
  - path: ../../configurator/ble/sidewalk.asconf
    directory: sidewalk
  - path: ../../mfg.runconf
    directory: sidewalk
tag:
  - hardware:rf:band:2400|915
  - hardware:device:sdid:215
filter:
  - name: Wireless Technology
    value:
      - Sidewalk
      - Bluetooth
  - name: Ecosystem
    value:
      - Amazon
  - name: Device Type
    value:
      - SoC
  - name: Project Difficulty
    value:
      - Beginner
template_contribution:
  - name: bluetooth_on_event
    value:
      include: ble_adapter.h
      function: sl_ble_adapter_on_event
  - name: event_handler
    value:
      event: kernel_start
      include: ble_adapter.h
      handler: sl_ble_adapter_on_kernel_start
  - name: cli_command
    value:
      name: send
      handler: cli_send
      help: Updates counter value and sends it to the cloud
  - name: cli_command
    value:
      name: reset
      handler: cli_reset
      help: Returns to factory settings
  - name: cli_command
    value:
      name: get_time
      handler: cli_get_time
      help: Gets current time
  - name: cli_command
    value:
      name: get_mtu
      handler: cli_get_mtu
      help: Gets current MTU
  - name: cli_command
    value:
      name: switch_link
      handler: cli_link_switch
      help: Switch between BLE/FSK/CSS depending on available
        radio links
