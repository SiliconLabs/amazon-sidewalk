project_name: amazon_sidewalk_soc_location
package: sidewalk_sample_app
quality: production
label: Amazon Sidewalk - SoC Location
description: The Location sample application leverages the Amazon
  Sidewalk protocol to provide and demonstrate location services.
category: Example|AWS IoT
sdk_extension:
  - id: sidewalk
    version: 2.7.0
source:
  - path: app_init.c
  - path: app_process.c
  - path: app_cli.c
include:
  - path: .
    file_list:
      - path: app_process.h
component:
  - id: sidewalk_pal
    from: sidewalk
  - id: sidewalk_common
    from: sidewalk
  - id: app_log
    from: sidewalk
  - id: sidewalk_log_app_rtt
    from: sidewalk
  - id: sidewalk_log_pal_rtt
    from: sidewalk
  - id: sidewalk_log_stack_rtt
    from: sidewalk
  - id: sidewalk_utils
    from: sidewalk
  - id: sidewalk_location_cli
    from: sidewalk
  - id: sidewalk_ble
    from: sidewalk
    condition:
      - device_supports_bluetooth
  - id: sidewalk_subghz_lr1110
    from: sidewalk
    condition:
      - sl_sidewalk_default_radio_sx1262
      - sl_sidewalk_board_has_radio_external_support
  - id: sidewalk_subghz_sx1262
    from: sidewalk
    condition:
      - sidewalk_kg100s
  - id: sidewalk_subghz_efr32xgxx
    from: sidewalk
    condition:
      - sl_sidewalk_default_radio_efr32xgxx
  - id: app_button_press
  - id: iostream_rtt
  - id: printf
  - id: sl_main
  - id: simple_button
    instance:
      - btn0
  - id: simple_button
    instance:
      - btn1
    condition:
      - sl_sidewalk_family_supports_2_btns
  - id: cli
    instance:
      - inst
  - id: emlib_gpio_simple_init
    instance:
      - exp_11
      - exp_12
      - exp_13
      - exp_14
    condition:
      - sidewalk_subghz_external_hw_support
      - sl_sidewalk_board_has_radio_external_support
  - id: emlib_gpio_simple_init
    instance:
      - exp_3
      - exp_5
      - exp_7
      - exp_9
    condition:
      - sidewalk_location_full
  - id: device_init
  - id: clock_manager
  - id: iostream_stdlib_config
  - id: sleeptimer
  - id: app_assert
  - id: freertos
  - id: freertos_heap_4
  - id: rail_lib_multiprotocol
    condition:
      - sl_sidewalk_radio_native
      - sl_sidewalk_radio_ble
  - id: memory_manager
  - id: power_manager
define:
  - name: MAIN_TASK_STACK_SIZE
    value: (6000 / sizeof(configSTACK_DEPTH_TYPE))
configuration:
  - name: SL_MBEDTLS_PSA_ASSUME_EXCLUSIVE_BUFFERS
    value: 1
  - name: SL_CLOCK_MANAGER_LFRCO_PRECISION
    value: 1
    condition:
      - hardware_board
    unless:
      - hardware_board_has_lfxo
  - name: SL_SIDEWALK_COMMON_DEFAULT_LINK_TYPE
    value: SL_SIDEWALK_LINK_BLE
    condition:
      - sl_sidewalk_radio_ble
  - name: SL_SIDEWALK_COMMON_DEFAULT_LINK_TYPE
    value: SL_SIDEWALK_LINK_FSK
    condition:
      - sl_sidewalk_radio_subghz
    unless:
      - sl_sidewalk_radio_ble
  - name: SL_SIDEWALK_COMMON_DEFAULT_LINK_CONNECTION_POLICY
    value: SID_LINK_CONNECTION_POLICY_MULTI_LINK_MANAGER
  - name: SL_SIDEWALK_COMMON_DEFAULT_MULTI_LINK_POLICY
    value: SID_LINK_MULTI_LINK_POLICY_RELIABILITY
  - name: SL_SPIDRV_EXP_CS_CONTROL
    value: spidrvCsControlApplication
    condition:
      - spidrv
  - name: SL_SPIDRV_EXP_BITRATE
    value: 8000000
    condition:
      - spidrv
  - name: SL_SLEEPTIMER_PERIPHERAL
    value: SL_SLEEPTIMER_PERIPHERAL_DEFAULT
  - name: SL_SID_LOG_APP_ENABLED
    value: 1
  - name: SL_SID_LOG_PAL_ENABLED
    value: 1
  - name: SID_PAL_LOG_ENABLED
    value: 1
  - name: SL_BOARD_ENABLE_VCOM
    value: 0
    condition:
      - iostream_usart
  - name: SL_IOSTREAM_USART_VCOM_RESTRICT_ENERGY_MODE_TO_ALLOW_RECEPTION
    value: 0
    condition:
      - iostream_usart
  - name: SL_IOSTREAM_USART_VCOM_FLOW_CONTROL_TYPE
    value: usartHwFlowControlNone
    condition:
      - iostream_usart
  - name: SL_CLI_INST_IOSTREAM_HANDLE
    value: sl_iostream_rtt_handle
  - name: configMINIMAL_STACK_SIZE
    value: 160
  - name: configTOTAL_HEAP_SIZE
    value: 21384
  - name: SL_STACK_SIZE
    value: 2048
  - name: NVM3_DEFAULT_NVM_SIZE
    value: 24576
  - name: SL_MAIN_START_TASK_STACK_SIZE_BYTES
    value: 2048
  - name: SL_BT_RTOS_LINK_LAYER_TASK_STACK_SIZE
    value: 1000
    condition:
      - sl_sidewalk_radio_ble
  - name: SL_BT_RTOS_HOST_STACK_TASK_STACK_SIZE
    value: 2000
    condition:
      - sl_sidewalk_radio_ble
  - name: SL_BT_RTOS_EVENT_HANDLER_STACK_SIZE
    value: 4000
  - name: SL_BT_CONFIG_BUFFER_SIZE
    value: 3150
    condition:
      - sl_sidewalk_radio_ble
  - name: configTIMER_TASK_STACK_DEPTH
    value: 160
  - name: APP_LOG_AUTO_NL
    value: 1
  - name: SL_BT_CONFIG_MIN_TX_POWER
    value: (-260)
    condition:
      - sl_sidewalk_radio_ble
  - name: SL_BT_CONFIG_MAX_TX_POWER
    value: (100)
    condition:
      - sl_sidewalk_radio_ble
  - name: APP_LOG_LEVEL_DEBUG_PREFIX
    value: '"<D>"'
  - name: APP_LOG_LEVEL_INFO_PREFIX
    value: '"<I>"'
  - name: APP_LOG_LEVEL_WARNING_PREFIX
    value: '"<W>"'
  - name: APP_LOG_LEVEL_ERROR_PREFIX
    value: '"<E>"'
  - name: APP_LOG_LEVEL_CRITICAL_PREFIX
    value: '"<C>"'
  - name: configUSE_MALLOC_FAILED_HOOK
    value: 1
  - name: configCHECK_FOR_STACK_OVERFLOW
    value: 2
readme:
  - path: ../../../documentation/example/amazon_sidewalk_soc_location/readme.md
ui_hints:
  highlight:
    - path: config/sidewalk/sidewalk.asconf
    - path: readme.md
      focus: true
config_file:
  - path: ../../../tools/cloudformation/public/CF_minimal_sidewalk.json
    directory: sidewalk
  - path: ../../configurator/fsk/sidewalk.asconf
    directory: sidewalk
    condition:
      - sl_sidewalk_radio_native
  - path: ../../configurator/ble/sidewalk.asconf
    directory: sidewalk
    unless:
      - sl_sidewalk_radio_native
  - path: ../../mfg.runconf
    directory: sidewalk
filter:
  - name: Wireless Technology
    value:
      - Sidewalk
      - Bluetooth
  - name: Ecosystem
    value:
      - Amazon
  - name: Device Type
    value:
      - SoC
  - name: Project Difficulty
    value:
      - Beginner
template_contribution:
  - name: bluetooth_on_event
    value:
      include: ble_adapter.h
      function: sl_ble_adapter_on_event
    condition:
      - sl_sidewalk_radio_ble
  - name: event_handler
    value:
      event: kernel_start
      include: ble_adapter.h
      handler: sl_ble_adapter_on_kernel_start
    condition:
      - sl_sidewalk_radio_ble
  - name: cli_command
    value:
      name: ble_connect
      handler: cli_ble_connect
      help: Triggers BLE connection request
  - name: cli_command
    value:
      name: send
      handler: cli_send
      help: Updates counter value and sends it to the cloud
  - name: cli_command
    value:
      name: reset
      handler: cli_reset
      help: Returns to factory settings
  - name: cli_command
    value:
      name: switch_link
      handler: cli_link_switch
      help: Switch between BLE/FSK/CSS depending on available
        radio links
