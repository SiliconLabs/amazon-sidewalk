id: sidewalk_nvm3_migrator
label: Sidewalk NVM3 Migrator
package: sidewalk
description: Provides functions to migrate Sidewalk NVM3 data
  to a new structure
category: Protocol
quality: production
metadata:
  sbom:
    license: Zlib
root_path: component
provides:
  - name: sidewalk_nvm3_migrator
source:
  - path: sidewalk_nvm3_migrator/sl_sidewalk_nvm3_migrator.c
include:
  - path: sidewalk_nvm3_migrator
    file_list:
      - path: sl_sidewalk_nvm3_migrator.h
  - path: amazon/projects/sid/sal/silabs/sid_pal/include/
    file_list:
      - path: nvm3_manager.h
config_file:
  - path: sidewalk_nvm3_migrator/config/sl_sidewalk_nvm3_migrator_config.h
requires:
  - name: nvm3_lib
  - name: nvm3_default
  - name: app_log
  - name: app_assert
  - name: memory_manager
  - name: sidewalk_log_pal
  - name: sidewalk_pal
recommends:
  - name: sidewalk_log_pal_rtt
template_contribution:
  - name: component_catalog
    value: sidewalk_nvm3_migrator
