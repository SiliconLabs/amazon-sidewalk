id: "sidewalk_ed25519"
label: "Sidewalk component containing an Ed25519 implementation"
package: "Flex"
description: "Sidewalk component containing an Ed25519 implementation"
category: Example|AWS IoT
quality: evaluation
metadata:
  sbom:
    license: MIT
root_path: "component/sidewalk_ed25519"

source:
  - path: "curve25519_mehdi.c"
  - path: "curve25519_order.c"
  - path: "curve25519_utils.c"
  - path: "ed25519_sign.c"
  - path: "ed25519_verify.c"
include:
  - path: "."
    file_list:
    - "path": "base_folding8.h"
    - "path": "BaseTypes.h"
    - "path": "curve25519_mehdi.h"
    - "path": "ed25519_signature.h"

provides:
  - name: "sidewalk_ed25519"
requires:
  - name: "psa_crypto"
  - name: "psa_driver"
  - name: "psa_crypto_sha512"
#-------------- Template Contribution ----------------
template_contribution:
#---------------- Component Catalog ------------------
  - name: component_catalog
    value: sidewalk_ed25519