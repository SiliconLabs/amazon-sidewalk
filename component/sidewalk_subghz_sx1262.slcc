id: sidewalk_subghz_sx1262
label: Amazon Sidewalk Sub-GHz SX1262
package: sidewalk
description: This component contains the support of Semtech SX1262 Sub-GHz chip
category: Example|AWS IoT
quality: production
metadata:
  sbom:
    license: Zlib AND LicenseRef-amazon-sidewalk-license
root_path: component
requires:
  - name: sl_sidewalk_family_has_radio_external_support
  - name: sidewalk_subghz_external_hw_support
  - name: sidewalk_common
  - name: sidewalk_ble_subghz
  - name: hardware_board_rb # exclude dev kits and explorer kit boards but not SOCs
    condition:
      - hardware_board
provides:
  - name: sidewalk_subghz_sx1262
  - name: sidewalk_external_subghz_chip
  - name: sl_sidewalk_radio_external
  - name: sl_sidewalk_radio_subghz
library:
  - path: ble_subghz/lib/sl_lib_radio_sx126x.a
source:
  - path: amazon/platform/sid_mcu/semtech/hal/sx126x/sx126x_hal.c
  - path: amazon/platform/sid_mcu/semtech/hal/sx126x/sx126x_radio_fsk.c
  - path: amazon/platform/sid_mcu/semtech/hal/sx126x/sx126x_radio_lora.c
  - path: amazon/platform/sid_mcu/semtech/hal/sx126x/sx126x_radio.c
  - path: ble_subghz/radio/subghz/semtech/sx1262/app_subghz_config.c
include:
  - path: amazon/platform/sid_mcu/semtech/hal/sx126x/include
    file_list:
      - path: sx126x_config.h
      - path: sx126x_radio.h
  - path: amazon/platform/sid_mcu/semtech/hal/sx126x/include/semtech
    file_list:
      - path: sx126x_hal.h
      - path: sx126x_halo.h
      - path: sx126x_regs.h
      - path: sx126x_timings.h
      - path: sx126x.h
  - path: amazon/platform/sid_mcu/semtech/hal/common
    file_list:
      - path: semtech_radio_ifc.h
  - path: ble_subghz/radio/subghz/semtech/sx1262
    file_list:
      - path: app_subghz_config.h
define:
  - name: SID_RADIO_PLATFORM_SX126X
    value: "1"
ui_hints:
  visibility: advanced
conflicts:
  - sidewalk_subghz_lr1110
  - sidewalk_subghz_efr32xgxx
  - device_generic_family_efr32xg23
  - device_generic_family_efr32xg25
  - device_generic_family_efr32xg27
  - device_generic_family_efr32xg29
  - device_generic_family_sixx301
