id: "sidewalk_pal_btl_ifc"
label: "Sidewalk PAL bootloader interface"
package: "Flex"
description: "Provides bootloader interface peripheral abstraction functions to sidewalk applications"
category: Example|AWS IoT
quality: evaluation
metadata:
  sbom:
    license: Zlib
root_path: "component/sidewalk_pal_btl_ifc"

requires:
  - name: "bootloader_interface"
  - name: "bootloader_app_properties"
  - name: "sidewalk_log_pal_rtt"
  - name: "sidewalk_ble_subghz"
provides:
  - name: "sidewalk_pal_btl_ifc"
source:
  - path: "sl_sidewalk_pal_btl_ifc.c"
include:
  - path: "."
    file_list:
    - path: "sl_sidewalk_pal_btl_ifc.h"

#-------------- Template Contribution ----------------
template_contribution:
#---------------- Component Catalog ------------------
  - name: component_catalog
    value: sidewalk_pal_btl_ifc