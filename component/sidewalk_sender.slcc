id: sidewalk_sender
label: Sidewalk sender
package: sidewalk
description: Provides Sidewalk message sending functions
category: Example
quality: production
metadata:
  sbom:
    license: Zlib
root_path: component/sidewalk_sender
provides:
  - name: sidewalk_sender
requires:
  - name: freertos
  - name: sidewalk_utils
  - name: sidewalk_log_app
  - name: sidewalk_pal
recommends:
  - id: sidewalk_log_app_rtt
source:
  - path: sl_sidewalk_sender.c
include:
  - path: .
    file_list:
      - path: sl_sidewalk_sender.h
template_contribution:
  - name: component_catalog
    value: sidewalk_sender
  - name: event_handler
    value:
      event: service_init
      include: sl_sidewalk_sender.h
      handler: sl_sidewalk_sender_init
ui_hints:
  visibility: never
