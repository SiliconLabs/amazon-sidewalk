id: sidewalk_qr_code
label: QR Code
package: sidewalk
description: Provides Sidewalk QR code functions
category: Example|AWS IoT
quality: production
metadata:
  sbom:
    license: Zlib
root_path: component/sidewalk_qr_code
provides:
  - name: sidewalk_qr_code
requires:
  - name: sidewalk_utils
  - name: sidewalk_ble_subghz
source:
  - path: qrcodegen.c
  - path: sl_sidewalk_qr_code.c
include:
  - path: .
    file_list:
      - path: qrcodegen.h
      - path: sli_sidewalk_qr_code.h
template_contribution:
  - name: component_catalog
    value: sidewalk_qr_code
