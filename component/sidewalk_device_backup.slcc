id: sidewalk_device_backup
label: Sidewalk device backup
package: sidewalk
description: Provides Sidewalk device backup functions
category: Example
quality: production
metadata:
  sbom:
    license: Zlib
root_path: component/sidewalk_device_backup
provides:
  - name: sidewalk_device_backup
requires:
  - name: nvm3_lib
  - name: sidewalk_log_pal
  - name: app_assert
  - name: memory_manager
  - name: emlib_msc
    condition:
      - device_generic_family_efr32xg24
  - name: emlib_msc
    condition:
      - device_generic_family_efr32xg28
  - name: clock_manager_runtime
    condition:
      - device_generic_family_efr32xg24
  - name: clock_manager_runtime
    condition:
      - device_generic_family_efr32xg28
  - name: se_manager
  - name: sidewalk_pal
recommends:
  - id: sidewalk_log_pal_rtt
source:
  - path: sl_sidewalk_device_backup.c
include:
  - path: .
    file_list:
      - path: sl_sidewalk_device_backup.h
      - path: sli_sidewalk_device_backup_certificate_common.h
template_contribution:
  - name: component_catalog
    value: sidewalk_device_backup
ui_hints:
  visibility: never
