id: "sidewalk_log_app_rtt"
label: "Sidewalk Log: App RTT"
package: "Flex"
description: "Sidewalk RTT log functionality to be used by app layer"
category: Example|AWS IoT
quality: production
metadata:
  sbom:
    license: Zlib
root_path: "component/sidewalk_log/src/app"

requires:
  - name: segger_rtt
  - name: iostream_rtt
  - name: sidewalk_log_core
provides:
  - name: sidewalk_log_app_rtt
  - name: sidewalk_log_app
source:
  - path: sl_sidewalk_log_app.c
include:
  - path: .
    file_list:
    - path: sl_sidewalk_log_app.h
config_file:
  - path: config/sl_sidewalk_log_app_rtt_config.h
define:
  - name: SID_PAL_LOG_RTT_ENABLED

template_contribution:
  - name: component_catalog
    value: sidewalk_log_app_rtt