id: "sidewalk_log_app_vcom"
label: "Sidewalk Log: App VCOM"
package: "Flex"
description: "Sidewalk VCOM log functionality to be used by app layer"
category: Example|AWS IoT
quality: production
metadata:
  sbom:
    license: Zlib
root_path: "component/sidewalk_log/src/app"

requires:
  - name: sidewalk_log_core
provides:
  - name: sidewalk_log_app_vcom
source:
  - path: sl_sidewalk_log_app.c
include:
  - path: .
    file_list:
    - path: sl_sidewalk_log_app.h
config_file:
  - path: config/sl_sidewalk_log_app_vcom_config.h

template_contribution:
  - name: component_catalog
    value: sidewalk_log_app_vcom