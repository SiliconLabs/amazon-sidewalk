id: "sidewalk_log_core"
label: "Sidewalk Log: Core"
package: "Flex"
description: "Sidewalk core log functionality"
category: Example|AWS IoT
quality: production
metadata:
  sbom:
    license: Zlib
root_path: "component/sidewalk_log/src/core"

requires:
  - name: iostream
  - name: app_log
    from: sidewalk
  - name: component_catalog
  - name: sidewalk_common
    condition:
      - sidewalk_ble_subghz
  - name: segger_rtt
    condition:
      - sidewalk_log_app_rtt
  - name: sidewalk_base_component
recommends:
  - id: sidewalk_ble_subghz
provides:
  - name: sidewalk_log_core
source:
  - path: sl_sidewalk_log_core.c
include:
  - path: "."
    file_list:
    - path: "sl_sidewalk_log_core.h"

#-------------- Template Contribution ----------------
template_contribution:
#---------------- Component Catalog ------------------
  - name: component_catalog
    value: sidewalk_log_core

ui_hints:
  visibility: never
