      - device_has_semailbox
  - name: psa_crypto_eddsa
    condition:
      - device_has_semailbox
  - name: sidewalk_ed25519
    condition:
      - device_generic_family_efr32xg27
  - name: sleeptimer
  - name: sidewalk_common
  - name: bluetooth_stack
    condition:
      - sl_sidewalk_radio_ble
  - name: rail_lib
  - name: component_catalog
  - name: nvm3_lib
  - name: nvm3_default
  - name: bluetooth_stack
    condition:
      - device_supports_bluetooth
  - name: bluetooth_feature_dynamic_gattdb
    condition:
      - device_supports_bluetooth
  - name: bluetooth_feature_gatt_server
    condition:
      - device_supports_bluetooth
  - name: bluetooth_feature_gatt
    condition:
      - device_supports_bluetooth
  - name: bluetooth_feature_system
    condition:
      - device_supports_bluetooth
  - name: bluetooth_feature_connection_role_peripheral
    condition:
      - device_supports_bluetooth
  - name: bluetooth_feature_legacy_advertiser
    condition:
      - device_supports_bluetooth
  - name: bluetooth_feature_sm
    condition:
      - device_supports_bluetooth
  - name: bluetooth_on_demand_start
    condition:
      - device_supports_bluetooth
