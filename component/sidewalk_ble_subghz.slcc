id: sidewalk_ble_subghz
label: Amazon Sidewalk
package: sidewalk
description: Simple component to gather all of the sidewalk related
  libraries and header files.
category: Example|AWS IoT
quality: production
metadata:
  sbom:
    license: Zlib AND LicenseRef-amazon-sidewalk-license
root_path: component
provides:
  - name: sidewalk_ble_subghz
  - name: sidewalk_base_component
requires:
  - name: sidewalk_log_pal
  - name: sidewalk_log_app
  - name: sidewalk_log_stack
  - name: memory_manager
  - name: gpio
  - name: app_assert
  - name: cmsis_core
  - name: clock_manager_runtime
  - name: sl_core
  - name: freertos
  - name: hal_system
  - name: psa_crypto
  - name: psa_its
  - name: psa_crypto_ecc
  - name: psa_crypto_ecdh
  - name: psa_crypto_ecdsa
  - name: psa_crypto_hmac
  - name: psa_crypto_cmac
  - name: psa_crypto_gcm
  - name: psa_crypto_ccm
  - name: psa_crypto_sha512
  - name: psa_crypto_ecc_curve25519
  - name: psa_crypto_ecc_secp256r1
  - name: psa_crypto_cipher_ctr
  - name: psa_crypto_sha256
  - name: psa_crypto_ecc_edwards25519
