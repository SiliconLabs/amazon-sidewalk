id: sidewalk_subghz_efr32xgxx
label: Sidewalk Sub-GHz efr32xgxx
package: sidewalk
description: This component contains the support of native (rail) Sub-GHz FSK
category: Protocol
quality: production
metadata:
  sbom:
    license: Zlib AND LicenseRef-amazon-sidewalk-license
root_path: component
requires:
  - name: device_has_radio_subghz
  - name: emlib_emu
  - name: rail_lib
  - name: sl_rail_util_compatible_pa
  - name: sidewalk_common
  - name: sidewalk_pal
provides:
  - name: sidewalk_subghz_efr32xgxx
  - name: sl_sidewalk_radio_native
  - name: sl_sidewalk_radio_subghz
  - name: sl_sidewalk_radio_subghz_fsk
  - name: sl_sidewalk_supports_915mhz
    condition:
      - hardware_board_supports_rf_band_915
  - name: sl_sidewalk_supports_868mhz
    condition:
      - hardware_board_supports_rf_band_868
source:
  - path: amazon/projects/sid/sal/silabs/sid_pal/efr32xgxx_radio/silabs/efr32xgxx.c
  - path: amazon/projects/sid/sal/silabs/sid_pal/efr32xgxx_radio/efr32xgxx_radio_fsk.c
  - path: amazon/projects/sid/sal/silabs/sid_pal/efr32xgxx_radio/efr32xgxx_radio_lora.c
  - path: amazon/projects/sid/sal/silabs/sid_pal/efr32xgxx_radio/efr32xgxx_radio.c
  - path: sidewalk_radio_config/subghz/rail/app_subghz_config.c
  - path: phys/xg28/efr32xgxx_railcfg.c
    condition:
      - device_generic_family_efr32xg28
    unless:
      - device_family_efr32sg28
  - path: phys/sg28/efr32xgxx_railcfg.c
    condition:
      - device_family_efr32sg28
  - path: phys/xg23/efr32xgxx_railcfg.c
    condition:
      - device_generic_family_efr32xg23
  - path: phys/xg25/efr32xgxx_railcfg.c
    condition:
      - device_generic_family_efr32xg25
include:
  - path: amazon/projects/sid/sal/silabs/sid_pal/efr32xgxx_radio/include
    file_list:
      - path: silabs/efr32xgxx.h
      - path: efr32xgxx_config.h
      - path: efr32xgxx_radio.h
  - path: sidewalk_radio_config/subghz/rail
    file_list:
      - path: app_subghz_config.h
define:
  - name: SL_RADIO_NATIVE
  - name: SL_FSK_SUPPORTED
  - name: RADIO_DRIVER_RAIL
    value: 1
  - name: SL_RAIL_3_API
  - name: SIDEWALK_SUPPORTED_FREQ_915MHZ
    condition:
      - hardware_board_supports_rf_band_915
  - name: SIDEWALK_SUPPORTED_FREQ_868MHZ
    condition:
      - hardware_board_supports_rf_band_868
ui_hints:
  visibility: advanced
conflicts:
  - name: sidewalk_subghz_lr1110
  - name: sidewalk_subghz_sx1262
  - name: sidewalk_kg100s
  - name: device_generic_family_efr32xg21
  - name: device_generic_family_efr32xg24
  - name: device_generic_family_efr32xg26
  - name: device_generic_family_efr32xg27
  - name: device_generic_family_efr32xg29
  - name: device_generic_family_sixx301
  - name: sidewalk_dmp_ble_support
