id: sidewalk_subghz_efr32xgxx
label: Amazon Sidewalk Sub-GHz efr32xgxx
package: sidewalk
description: This component contains the support of native (rail) Sub-GHz FSK
category: Example|AWS IoT
quality: production
metadata:
  sbom:
    license: Zlib AND LicenseRef-amazon-sidewalk-license
root_path: component
requires:
  - name: device_has_radio_subghz
  - name: emlib_emu
  - name: rail_util_pa
  - name: sidewalk_common
provides:
  - name: sidewalk_subghz_efr32xgxx
  - name: sl_sidewalk_radio_native
  - name: sl_sidewalk_radio_subghz
source:
  - path: amazon/projects/sid/sal/silabs/sid_pal/efr32xgxx_radio/silabs/efr32xgxx.c
  - path: amazon/projects/sid/sal/silabs/sid_pal/efr32xgxx_radio/efr32xgxx_radio_fsk.c
  - path: amazon/projects/sid/sal/silabs/sid_pal/efr32xgxx_radio/efr32xgxx_radio_lora.c
  - path: amazon/projects/sid/sal/silabs/sid_pal/efr32xgxx_radio/efr32xgxx_radio.c
  - path: ble_subghz/radio/subghz/rail/app_subghz_config.c
    unless:
      - sidewalk_dmp_ble_support
  - path: phys/xg28/efr32xgxx_railcfg.c
    condition:
      - device_generic_family_efr32xg28
    unless:
      - device_family_efr32sg28
  - path: phys/sg28/efr32xgxx_railcfg.c
    condition:
      - device_family_efr32sg28
  - path: phys/xg23/efr32xgxx_railcfg.c
    condition:
      - device_generic_family_efr32xg23
  - path: phys/xg25/efr32xgxx_railcfg.c
    condition:
      - device_generic_family_efr32xg25
include:
  - path: amazon/projects/sid/sal/silabs/sid_pal/efr32xgxx_radio/include
    file_list:
      - path: silabs/efr32xgxx.h
      - path: efr32xgxx_config.h
      - path: efr32xgxx_radio.h
  - path: ble_subghz/radio/subghz/rail
    file_list:
      - path: app_subghz_config.h
    unless:
      - sidewalk_dmp_ble_support
ui_hints:
  visibility: advanced
conflicts:
  - sidewalk_subghz_lr1110
  - sidewalk_subghz_sx1262
  - device_generic_family_efr32xg21
  - device_generic_family_efr32xg24
  - device_generic_family_efr32xg26
  - device_generic_family_efr32xg27
  - device_generic_family_efr32xg29
  - device_generic_family_sixx301
